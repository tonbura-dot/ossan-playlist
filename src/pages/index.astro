---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import PostCard from '../components/PostCard.astro';
import NightBridge from '../components/NightBridge.astro';
import Opening from '../components/opening/Opening.astro';
import { SITE } from '../site.config';
import { getPosts, url, categoriesOf } from '../lib/posts';

const posts = await getPosts();
const [featured, ...others] = posts.slice(0, 4);
const cats = categoriesOf(posts);
const showRandom = posts.length >= SITE.randomButtonMinPosts;
const randomUrls = posts.map((p) => url(`posts/${p.id}/`));
---
<Base>
  <Fragment slot="head">
    <script is:inline>
      // オープニングを再生するか、描画の前に決める（初回 or ?opening=1）。
      // localStorage が使えない環境では毎回再生する。
      (function () {
        var play = /[?&]opening=1/.test(location.search);
        if (!play) {
          try { play = localStorage.getItem('ossan-opening-seen') !== '1'; } catch (e) { play = true; }
        }
        if (!play) return;
        var d = document.documentElement;
        d.classList.add('op-play');
        // 保険: 演出のプログラムが読み込めなかったときは、5秒で通常のページに戻す
        setTimeout(function () {
          var o = document.getElementById('opening');
          if (o && o.classList.contains('is-running')) return;
          d.classList.remove('op-play');
          if (o) o.remove();
        }, 5000);
      })();
    </script>
  </Fragment>
  <Opening slot="before" posts={posts} />

  <section class="hero">
    <div class="hero__sky" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="hero__eyebrow">MURORAN ／ 室蘭の窓際から</p>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__catch">{SITE.catch}</p>
      <div class="hero__actions">
        <a class="button" href="#latest-title">最新の記事を読む</a>
        <a class="button button--ghost hero__replay" href={url('?opening=1')}>オープニングを見る</a>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <NightBridge id="hero" live fit="xMidYMax meet" />
    </div>
  </section>

  <section class="wrap block" aria-labelledby="latest-title">
    <h2 class="section-title" id="latest-title">最新の記事 <small>Latest</small></h2>
    {featured && <div class="featured"><PostCard post={featured} eager feature /></div>}
    {others.length > 0 && <div class="others"><PostGrid posts={others} /></div>}
    <p class="more"><a class="button button--ghost" href={url('posts/')}>記事をぜんぶ見る（{posts.length}本）</a></p>
  </section>

  {showRandom && (
    <section class="wrap block" aria-label="ランダムに読む">
      <div class="random">
        <svg class="random__gull" viewBox="0 0 64 32" aria-hidden="true"><path d="M2 20 Q16 4 32 18 Q48 4 62 20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" /></svg>
        <p>どれから読むか迷ったら、<br />窓の外のカモメに任せてください。</p>
        <a class="button" id="random-post" href={url('posts/')} data-urls={JSON.stringify(randomUrls)}>ランダムに1本読む</a>
      </div>
    </section>
  )}

  <section class="wrap block" aria-labelledby="cat-title">
    <h2 class="section-title" id="cat-title">カテゴリー <small>Categories</small></h2>
    <ul class="cats">
      {cats.map((c) => (
        <li>
          <a class="cat" href={url(`category/${c.slug}/`)}>
            <span class="cat__icon" aria-hidden="true">
              {c.slug === 'discovery' ? (
                <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
              ) : c.slug === 'review' ? (
                <svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" /></svg>
              ) : (
                <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="1.5" /><path d="M12 4v16M4 12h16" /></svg>
              )}
            </span>
            <span class="cat__name">{c.name}</span>
            {c.blurb && <span class="cat__blurb">{c.blurb}</span>}
            <span class="cat__count">{c.count} 本 →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block split">
    <div class="panel" aria-labelledby="profile-title">
      <h2 class="section-title" id="profile-title">書いている人 <small>Profile</small></h2>
      <p class="panel__name">{SITE.author}</p>
      <p>{SITE.profileSummary}</p>
      <p><a href={url('profile/')}>くわしく →</a></p>
    </div>
    <div class="panel" aria-labelledby="contact-title">
      <h2 class="section-title" id="contact-title">お問い合わせ <small>Contact</small></h2>
      <p>ご感想や、記事の間違いのご指摘など、気軽にどうぞ。</p>
      <p><a class="button" href={url('contact/')}>お問い合わせフォームへ</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---- ヒーロー（白鳥大橋の夜景） ---- */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
    --art-w: max(100vw, 56rem);
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(to bottom, #050816 0%, #0b1533 40%, #1c2550 100%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 10vh, 6rem) 0;
    text-align: center;
  }
  .hero__art {
    position: relative;
    z-index: 0;
    flex: none;
    width: var(--art-w);
    aspect-ratio: 16 / 9;
    margin-left: calc((100% - var(--art-w)) / 2);
    /* 絵の上のほう（星空）は文字の後ろに回す */
    margin-top: calc(var(--art-w) * -0.17);
    /* 水平線（絵の高さの 2/3）から下を海の色に */
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgb(167 112 106 / 0.55) 66.5%,
      #1a2442 66.7%,
      var(--bg) 100%
    );
  }
  .hero__art :global(svg) { width: 100%; height: 100%; }
  .hero__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    color: var(--cool);
  }
  .hero__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2.5rem, 10vw, 5.5rem);
    line-height: 1.15;
    letter-spacing: 0.08em;
    color: #fff;
    text-shadow: 0 0 30px rgb(159 212 255 / 0.45), 0 0 2px rgb(255 255 255 / 0.6);
  }
  .hero__catch {
    margin: 1.1rem auto 0;
    max-width: 30rem;
    font-family: var(--font-head);
    font-size: clamp(1rem, 3.4vw, 1.3rem);
    color: var(--warm);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero__replay { background: rgb(10 15 31 / 0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow, .hero__title, .hero__catch, .hero__actions {
      animation: hero-in 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__title { animation-delay: 0.1s; }
    .hero__catch { animation-delay: 0.25s; }
    .hero__actions { animation-delay: 0.4s; }
  }
  @keyframes hero-in { from { opacity: 0; transform: translateY(16px); } }

  /* ---- 記事 ---- */
  .block { margin-top: clamp(3rem, 8vw, 5rem); }
  .featured { margin-bottom: clamp(1rem, 3vw, 1.5rem); }
  .more { margin: 2rem 0 0; text-align: center; }

  /* ---- ランダム ---- */
  .random {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2rem, 6vw, 3rem) 1.5rem;
    text-align: center;
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(30rem 12rem at 50% 120%, rgb(255 150 60 / 0.25), transparent 70%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .random p { margin: 0; font-family: var(--font-head); font-size: clamp(1.05rem, 3.5vw, 1.3rem); }
  .random__gull { width: 3rem; color: var(--cool); }
  @media (prefers-reduced-motion: no-preference) {
    .random__gull { animation: gull 3.5s ease-in-out infinite; }
  }
  @keyframes gull { 50% { transform: translate(10px, -6px) rotate(-4deg); } }

  /* ---- カテゴリー ---- */
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.3rem 1.3rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .cat:hover { transform: translateY(-3px); box-shadow: var(--glow); border-color: rgb(255 179 92 / 0.5); }
  .cat__icon svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgb(255 179 92 / 0.45));
  }
  .cat__name { font-family: var(--font-head); font-size: 1.35rem; font-weight: 700; }
  .cat__blurb { font-size: 0.88rem; color: var(--muted); line-height: 1.7; }
  .cat__count { font-size: 0.8rem; color: var(--accent); margin-top: 0.25rem; }

  /* ---- 書いている人・お問い合わせ ---- */
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .panel {
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
  }
  .panel p { margin: 0.6rem 0 0; }
  .panel .section-title { margin-bottom: 0.5rem; }
  .panel__name { font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; }
</style>

<script>
  const btn = document.getElementById('random-post') as HTMLAnchorElement | null;
  if (btn) {
    btn.addEventListener('click', (e) => {
      const urls: string[] = JSON.parse(btn.dataset.urls || '[]');
      if (!urls.length) return;
      e.preventDefault();
      location.href = urls[Math.floor(Math.random() * urls.length)];
    });
  }
</script>
