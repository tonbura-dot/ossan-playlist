---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import Opening from '../components/opening/Opening.astro';
import { SITE } from '../site.config';
import { getPosts, url, categoriesOf } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const cats = categoriesOf(posts);
const showRandom = posts.length >= SITE.randomButtonMinPosts;
const randomUrls = posts.map((p) => url(`posts/${p.id}/`));
---
<Base>
  <Fragment slot="head">
    <script is:inline>
      // オープニングを再生するか、描画の前に決める（初回 or ?opening=1）。
      // localStorage が使えない環境では毎回再生する。
      (function () {
        var play = /[?&]opening=1/.test(location.search);
        if (!play) {
          try { play = localStorage.getItem('ossan-opening-seen') !== '1'; } catch (e) { play = true; }
        }
        if (!play) return;
        var d = document.documentElement;
        d.classList.add('op-play');
        // 保険: 演出のプログラムが読み込めなかったときは、5秒で通常のページに戻す
        setTimeout(function () {
          var o = document.getElementById('opening');
          if (o && o.classList.contains('is-running')) return;
          d.classList.remove('op-play');
          if (o) o.remove();
        }, 5000);
      })();
    </script>
  </Fragment>
  <Opening slot="before" posts={posts} />

  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">室蘭の窓際から</p>
        <h1 class="hero__title">{SITE.name}</h1>
        <p class="hero__catch">{SITE.catch}</p>
        <p class="hero__by">書いている人：{SITE.author}</p>
      </div>
      <div class="hero__window" aria-hidden="true">
        <svg viewBox="0 0 320 240">
          <defs>
            <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#9fc3dd" />
              <stop offset="1" stop-color="#eef2ef" />
            </linearGradient>
          </defs>
          <rect x="10" y="10" width="300" height="200" rx="4" fill="url(#hero-sky)" />
          <path d="M10 160 Q120 148 200 156 T310 150 V210 H10Z" fill="#3c6e8a" />
          <path d="M40 140 H290" stroke="#fff" stroke-width="3" />
          <path d="M100 140 V82 M220 140 V82" stroke="#fff" stroke-width="4" />
          <path d="M40 140 Q70 128 100 84 Q160 150 220 84 Q250 128 290 140" fill="none" stroke="#fff" stroke-width="1.6" />
          <circle cx="262" cy="46" r="14" fill="#f2c67a" />
          <rect x="10" y="10" width="300" height="200" rx="4" fill="none" stroke="var(--ink)" stroke-width="8" />
          <path d="M160 10 V210" stroke="var(--ink)" stroke-width="6" />
          <rect x="0" y="210" width="320" height="16" rx="3" fill="var(--warm)" opacity="0.85" />
          <rect x="34" y="188" width="26" height="22" rx="4" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" />
        </svg>
      </div>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="latest-title">
    <h2 class="section-title" id="latest-title">最新の記事 <small>Latest</small></h2>
    <PostGrid posts={latest} />
    <p class="more"><a class="button button--ghost" href={url('posts/')}>記事一覧へ</a></p>
  </section>

  {showRandom && (
    <section class="wrap block random" aria-label="ランダムに読む">
      <p>どれから読むか迷ったら、窓の外のカモメに任せてください。</p>
      <a class="button" id="random-post" href={url('posts/')} data-urls={JSON.stringify(randomUrls)}>ランダムに1本読む</a>
    </section>
  )}

  <section class="wrap block" aria-labelledby="cat-title">
    <h2 class="section-title" id="cat-title">カテゴリー <small>Categories</small></h2>
    <ul class="cats">
      {cats.map((c) => (
        <li>
          <a class="cat" href={url(`category/${c.slug}/`)}>
            <span class="cat__name">{c.name}</span>
            {c.blurb && <span class="cat__blurb">{c.blurb}</span>}
            <span class="cat__count">{c.count} 本</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block split">
    <div class="panel" aria-labelledby="profile-title">
      <h2 class="section-title" id="profile-title">書いている人 <small>Profile</small></h2>
      <p class="panel__name">{SITE.author}</p>
      <p>{SITE.profileSummary}</p>
      <p><a href={url('profile/')}>くわしく →</a></p>
    </div>
    <div class="panel" aria-labelledby="contact-title">
      <h2 class="section-title" id="contact-title">お問い合わせ <small>Contact</small></h2>
      <p>ご感想や、記事の間違いのご指摘など、気軽にどうぞ。</p>
      <p><a class="button" href={url('contact/')}>お問い合わせフォームへ</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--warm) 16%, transparent), transparent 70%),
      var(--bg);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2.5rem, 8vw, 5rem);
  }
  .hero__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--accent);
  }
  .hero__title {
    margin: 0.4rem 0 0;
    font-size: clamp(2.1rem, 8vw, 3.8rem);
    line-height: 1.2;
    letter-spacing: 0.06em;
  }
  .hero__catch {
    margin: 1rem 0 0;
    font-size: clamp(1rem, 3.2vw, 1.25rem);
    font-family: var(--font-head);
  }
  .hero__by { margin: 0.75rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .hero__window svg { width: 100%; max-width: 22rem; margin-inline: auto; display: block; }

  @media (max-width: 44rem) {
    .hero__inner { grid-template-columns: 1fr; text-align: center; gap: 1.5rem; }
    .hero__window svg { max-width: 15rem; }
  }

  .block { margin-top: clamp(2.5rem, 7vw, 4rem); }
  .more { margin: 1.5rem 0 0; text-align: center; }

  .random {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--warm);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--warm) 7%, var(--surface));
    max-width: calc(var(--wrap) - var(--gutter) * 2);
  }
  .random p { margin: 0; }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .cat:hover { border-color: var(--accent); }
  .cat__name { font-family: var(--font-head); font-size: 1.25rem; font-weight: 700; }
  .cat__blurb { font-size: 0.88rem; color: var(--muted); line-height: 1.7; }
  .cat__count { font-size: 0.8rem; color: var(--accent); }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .panel p { margin: 0.6rem 0 0; }
  .panel .section-title { margin-bottom: 0.5rem; }
  .panel__name { font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; }
</style>

<script>
  const btn = document.getElementById('random-post') as HTMLAnchorElement | null;
  if (btn) {
    btn.addEventListener('click', (e) => {
      const urls: string[] = JSON.parse(btn.dataset.urls || '[]');
      if (!urls.length) return;
      e.preventDefault();
      location.href = urls[Math.floor(Math.random() * urls.length)];
    });
  }
</script>
