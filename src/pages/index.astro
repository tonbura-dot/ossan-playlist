---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Opening from '../components/opening/Opening.astro';
import AccessCounter from '../components/AccessCounter.astro';
import { SITE } from '../site.config';
import { getPosts, url, categoriesOf, isoDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts[0];
const tracks = posts.slice(0, 10);
const cats = categoriesOf(posts);
const showRandom = posts.length >= SITE.randomButtonMinPosts;
const randomUrls = posts.map((p) => url(`posts/${p.id}/`));

// サイト名を「○○の」と「プレイリスト」の2段に分けてネオン管にする
const cut = SITE.name.indexOf('の');
const nameSub = cut > 0 ? SITE.name.slice(0, cut + 1) : '';
const nameMain = cut > 0 ? SITE.name.slice(cut + 1) : SITE.name;

// 「読み終わるまでの目安」を曲の長さのように見せる（1分600字）
const duration = (body = '') => {
  const chars = body.replace(/^---[\s\S]*?---/, '').replace(/[\s#*>!\[\]()_`-]/g, '').length;
  const sec = Math.max(30, Math.round((chars / 600) * 60));
  return `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
};
const shortDate = (d: Date) => d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', month: 'long', day: 'numeric' });
---
<Base>
  <Fragment slot="head">
    <script is:inline>
      // オープニングを再生するか、描画の前に決める（初回 or ?opening=1）。
      // localStorage が使えない環境では毎回再生する。
      (function () {
        var play = /[?&]opening=1/.test(location.search);
        if (!play) {
          try { play = localStorage.getItem('ossan-opening-seen') !== '1'; } catch (e) { play = true; }
        }
        if (!play) return;
        var d = document.documentElement;
        d.classList.add('op-play');
        // 保険: 演出のプログラムが読み込めなかったときは、5秒で通常のページに戻す
        setTimeout(function () {
          var o = document.getElementById('opening');
          if (o && o.classList.contains('is-running')) return;
          d.classList.remove('op-play');
          if (o) o.remove();
        }, 5000);
      })();
    </script>
  </Fragment>
  <Opening slot="before" />

  <section class="hero">
    <div class="wrap hero__inner">
      <button class="sign" id="onair" type="button" aria-pressed="true" aria-label="ON AIR ランプ（押すと消灯・点灯）">
        <span class="sign__text">ON AIR</span>
      </button>
      <h1 class="neon-title">
        {nameSub && <span class="neon-title__sub">{nameSub}</span>}
        <span class="neon-title__main">{nameMain}</span>
      </h1>
      <p class="freq" aria-hidden="true"><span>FM</span><span class="freq__dial"><i></i></span><span>24:00</span></p>
      <p class="hero__catch">{SITE.catch}</p>
      <div class="hero__actions">
        {latest && <a class="button" href={url(`posts/${latest.id}/`)}>▶ 最新回を聴く</a>}
        <a class="button button--ghost" href={url('?opening=1')}>オープニングを見る</a>
      </div>
      <AccessCounter />
    </div>
  </section>

  {latest && (
    <section class="wrap block" aria-label="最新の記事">
      <a class="now" href={url(`posts/${latest.id}/`)}>
        {latest.data.image && (
          <Image class="now__img" src={latest.data.image} alt="" widths={[600, 900, 1200]} sizes="(max-width: 48rem) 100vw, 34rem" loading="eager" />
        )}
        <div class="now__body">
          <p class="now__label"><span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>NOW PLAYING</p>
          <h2 class="now__title">{latest.data.title}</h2>
          {latest.data.description && <p class="now__desc">{latest.data.description}</p>}
          <p class="now__meta"><time datetime={isoDate(latest.data.date)}>{latest.data.category}・{shortDate(latest.data.date)}</time></p>
          <div class="now__bar" aria-hidden="true"><span></span></div>
          <p class="now__time" aria-hidden="true"><span>0:00</span><span>{duration(latest.body)}</span></p>
        </div>
      </a>
    </section>
  )}

  <section class="wrap block" aria-labelledby="latest-title">
    <div class="list-head">
      <h2 class="list-head__title" id="latest-title">SIDE A <small>最新の{tracks.length}本</small></h2>
      <p>時間は「読み終わるまでの目安」</p>
    </div>
    <ol class="tracks">
      {tracks.map((p, i) => (
        <li>
          <a class:list={['track', { 'is-now': i === 0 }]} href={url(`posts/${p.id}/`)}>
            <span class="track__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="track__tt">
              <b>{p.data.title}</b>
              {p.data.description && <small>{p.data.description}</small>}
            </span>
            <span class="track__genre">{p.data.category}</span>
            <time class="track__date" datetime={isoDate(p.data.date)}>{shortDate(p.data.date)}</time>
            <span class="track__dur" aria-label={`読み終わるまで約${duration(p.body)}`}>{duration(p.body)}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a class="button button--ghost" href={url('posts/')}>記事をぜんぶ見る（{posts.length}本）</a></p>
  </section>

  <section class="wrap block bottom">
    <div class="box" aria-labelledby="genre-title">
      <h2 class="box__label" id="genre-title">ジャンル</h2>
      <ul class="chips">
        {cats.map((c) => (
          <li><a class="genre" href={url(`category/${c.slug}/`)} title={c.blurb || undefined}>{c.name}<span>{c.count}</span></a></li>
        ))}
      </ul>
      {showRandom && (
        <a class="button button--ghost shuffle" id="random-post" href={url('posts/')} data-urls={JSON.stringify(randomUrls)} title="ランダムに1本読む">⤨ シャッフル再生</a>
      )}
    </div>
    <div class="box" aria-labelledby="profile-title">
      <h2 class="box__label" id="profile-title">パーソナリティ</h2>
      <p class="box__name">{SITE.author}</p>
      <p class="box__text">{SITE.profileSummary}</p>
      <p><a href={url('profile/')}>くわしく →</a></p>
    </div>
    <div class="box box--req" aria-labelledby="contact-title">
      <h2 class="box__label" id="contact-title">リクエスト・おたより</h2>
      <p class="box__text">ご感想や、記事の間違いのご指摘など、気軽にどうぞ。</p>
      <p><a class="button" href={url('contact/')}>おたよりを送る</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---- ヒーロー：ON AIR ランプとネオン管のサイト名 ---- */
  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 3vw, 2rem);
  }
  .sign {
    font: inherit;
    cursor: pointer;
    padding: 0.5rem 1.6rem 0.6rem;
    border-radius: 14px;
    border: 3px solid var(--tube);
    background: rgb(255 42 79 / 0.08);
    box-shadow: 0 0 4px #fff, 0 0 10px var(--onair), 0 0 26px var(--onair), 0 0 60px rgb(255 42 79 / 0.45), inset 0 0 12px var(--onair), inset 0 0 30px rgb(255 42 79 / 0.35);
    transition: box-shadow 0.25s, border-color 0.25s, background 0.25s;
  }
  .sign__text {
    display: block;
    padding-left: 0.14em;
    font-family: var(--font-neon);
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: 0.14em;
    color: var(--tube);
    text-shadow: var(--neon-red);
    transition: color 0.25s, text-shadow 0.25s;
  }
  .sign[aria-pressed='false'] { border-color: #3a2a30; background: transparent; box-shadow: none; }
  .sign[aria-pressed='false'] .sign__text { color: #4a3439; text-shadow: none; }

  .neon-title {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    margin: clamp(1.8rem, 5vw, 2.6rem) 0 0;
    font-family: var(--font-head);
    font-weight: 500;
    letter-spacing: 0;
  }
  .neon-title__sub {
    padding-left: 0.3em;
    font-size: clamp(1.3rem, 4.5vw, 2.1rem);
    letter-spacing: 0.3em;
    color: #effcff;
    text-shadow: var(--neon-ice);
  }
  .neon-title__main {
    font-size: clamp(2.7rem, 11vw, 6.4rem);
    line-height: 1.15;
    letter-spacing: 0.06em;
    color: var(--tube);
    text-shadow: var(--neon-pink);
  }
  .neon-title__sub, .neon-title__main { -webkit-text-stroke: 0.5px rgb(255 255 255 / 0.35); transition: color 0.25s, text-shadow 0.25s; }
  .hero.is-off .neon-title__main { color: #3d2a31; text-shadow: none; -webkit-text-stroke: 0.5px #5a3a45; }
  .hero.is-off .neon-title__sub { color: #233338; text-shadow: none; -webkit-text-stroke: 0.5px #2f4a52; }

  .freq {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--muted);
  }
  .freq__dial { position: relative; width: clamp(6rem, 22vw, 11rem); height: 1rem; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 8px); }
  .freq__dial i { position: absolute; top: -2px; bottom: -2px; left: 62%; width: 2px; background: var(--onair); box-shadow: 0 0 6px var(--onair), 0 0 12px var(--onair); }
  .hero__catch { margin: 1.1rem 0 0; font-size: clamp(1rem, 2.6vw, 1.2rem); opacity: 0.85; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 1.8rem; }

  /* 点灯の演出：最初にチカチカしてから安定する */
  @media (prefers-reduced-motion: no-preference) {
    .sign[aria-pressed='true'] .sign__text { animation: flicker 2.2s linear 0.3s both; }
    .neon-title__sub { animation: flicker 1.4s linear 0.8s both; }
    .neon-title__main { animation: flicker 1.8s linear 1.1s both; }
    .hero.is-off .neon-title__sub, .hero.is-off .neon-title__main { animation: none; }
    /* オープニングの再生中は待っておく */
    :global(.op-play) .sign__text, :global(.op-play) .neon-title__sub, :global(.op-play) .neon-title__main { animation-play-state: paused; }
  }
  @keyframes flicker {
    0%, 8%, 12%, 30%, 34% { opacity: 0.15; text-shadow: none; }
    10%, 32%, 60%, 64%, 100% { opacity: 1; }
    62% { opacity: 0.6; }
  }

  .block { margin-top: clamp(2.5rem, 7vw, 4.5rem); }

  /* ---- NOW PLAYING ---- */
  .now {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    padding: clamp(0.9rem, 2.5vw, 1.3rem);
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .now:hover { border-color: rgb(255 92 138 / 0.6); box-shadow: 0 0 24px rgb(255 92 138 / 0.18); }
  .now :global(.now__img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 12px; }
  .now__body { display: grid; gap: 0.35rem; min-width: 0; }
  .now__body p { margin: 0; }
  .now__label { display: flex; align-items: center; gap: 0.55rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.22em; color: var(--onair); text-shadow: 0 0 8px rgb(255 42 79 / 0.45); }
  .now__title { margin: 0; font-size: clamp(1.4rem, 3.6vw, 1.9rem); line-height: 1.35; }
  .now__desc { color: var(--muted); font-size: 0.92rem; }
  .now__meta { font-size: 0.8rem; color: var(--cool); }
  .eq { display: inline-flex; align-items: end; gap: 2px; height: 0.8rem; }
  .eq i { width: 3px; height: 40%; background: var(--onair); box-shadow: 0 0 6px var(--onair); }
  .eq i:nth-child(2) { height: 90%; }
  .eq i:nth-child(3) { height: 60%; }
  .eq i:nth-child(4) { height: 75%; }
  .now__bar { height: 3px; margin-top: 0.7rem; background: var(--line); border-radius: 2px; overflow: hidden; }
  .now__bar span { display: block; height: 100%; width: 22%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .now__time { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .eq i { animation: eq 0.9s ease-in-out infinite alternate; }
    .eq i:nth-child(2) { animation-delay: -0.3s; }
    .eq i:nth-child(3) { animation-delay: -0.6s; }
    .eq i:nth-child(4) { animation-delay: -0.15s; }
    .now__bar span { animation: prog 40s linear infinite alternate; }
  }
  @keyframes eq { to { height: 15%; } }
  @keyframes prog { to { width: 92%; } }

  /* ---- 曲目リスト ---- */
  .list-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.3rem 1rem; margin-bottom: 0.8rem; }
  .list-head p { margin: 0; font-size: 0.78rem; color: var(--muted); }
  .list-head__title { margin: 0; font-family: var(--font-neon); font-weight: 400; font-size: 1.8rem; letter-spacing: 0.08em; color: var(--tube); text-shadow: 0 0 4px var(--cool), 0 0 14px rgb(127 231 255 / 0.5); }
  .list-head__title small { margin-left: 0.5rem; font-family: var(--font-body); font-size: 0.85rem; letter-spacing: 0; color: var(--muted); text-shadow: none; }
  .tracks { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .track {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 5rem 5.5rem 3.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.7rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: background 0.15s;
  }
  .track::before { content: ''; position: absolute; left: 0; top: 22%; bottom: 22%; width: 2px; border-radius: 2px; background: var(--accent); box-shadow: 0 0 8px var(--accent), 0 0 16px var(--accent); opacity: 0; transition: opacity 0.15s; }
  .track:hover { background: linear-gradient(90deg, rgb(255 92 138 / 0.08), transparent 60%); }
  .track:hover::before, .track.is-now::before { opacity: 1; }
  .track__no, .track__date, .track__dur { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .track:hover .track__no, .track.is-now .track__no { color: var(--tube); text-shadow: 0 0 6px var(--accent), 0 0 14px var(--accent); }
  .track__dur { text-align: right; }
  .track__tt { display: grid; min-width: 0; }
  .track__tt b { font-weight: 700; font-size: 1.02rem; }
  .track__tt small { font-size: 0.8rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .track__genre { justify-self: start; font-size: 0.75rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.05rem 0.6rem; }
  .more { margin: 2rem 0 0; text-align: center; }

  /* ---- 下段 ---- */
  .bottom { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .box { display: grid; align-content: start; gap: 0.8rem; padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; }
  .box p { margin: 0; }
  .box--req { border-color: rgb(255 92 138 / 0.35); }
  .box__label { margin: 0; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; letter-spacing: 0.22em; color: var(--muted); }
  .box__name { font-family: var(--font-head); font-weight: 700; font-size: 1.4rem; }
  .box__text { font-size: 0.9rem; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .genre { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.9rem; color: var(--ink); font-weight: 700; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; transition: border-color 0.2s, box-shadow 0.2s; }
  .genre span { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; color: var(--cool); }
  .genre:hover { border-color: var(--cool); box-shadow: 0 0 12px rgb(127 231 255 / 0.3); }
  .shuffle { justify-self: start; }

  @media (max-width: 48rem) {
    .now { grid-template-columns: minmax(0, 1fr); }
    .track { grid-template-columns: 2rem minmax(0, 1fr) 3rem; gap: 0.2rem 0.8rem; }
    .track__genre, .track__date { display: none; }
  }
</style>

<script>
  // ON AIR ランプは押すと消灯・点灯（サイト名のネオンも一緒に消える）
  const sign = document.getElementById('onair');
  if (sign) {
    sign.addEventListener('click', () => {
      const on = sign.getAttribute('aria-pressed') !== 'true';
      sign.setAttribute('aria-pressed', on ? 'true' : 'false');
      sign.closest('.hero')?.classList.toggle('is-off', !on);
    });
  }

  const btn = document.getElementById('random-post') as HTMLAnchorElement | null;
  if (btn) {
    btn.addEventListener('click', (e) => {
      const urls: string[] = JSON.parse(btn.dataset.urls || '[]');
      if (!urls.length) return;
      e.preventDefault();
      location.href = urls[Math.floor(Math.random() * urls.length)];
    });
  }
</script>
