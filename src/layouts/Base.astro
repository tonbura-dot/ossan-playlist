---
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.catch}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: url('posts/'), label: '記事' },
  { href: url('profile/'), label: 'プロフィール' },
  { href: url('contact/'), label: 'お問い合わせ' },
];
const isCurrent = (href: string) => path === href || (href !== url('') && path.startsWith(href));

// フッターの工場夜景のシルエット（決まった並びの乱数で毎回同じ形）
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
let skyline = 'M0,120 L0,96';
const skylineLights: { x: number; y: number; r: number; red: boolean }[] = [];
for (let x = 0; x < 1600; ) {
  const w = 20 + rnd() * 60;
  const h = 10 + rnd() * (rnd() > 0.8 ? 60 : 28);
  skyline += ` L${x.toFixed(0)},${(120 - h).toFixed(0)} L${(x + w).toFixed(0)},${(120 - h).toFixed(0)}`;
  if (rnd() > 0.75) {
    const cx = x + w / 2;
    skyline += ` L${cx.toFixed(0)},${(120 - h).toFixed(0)} L${cx.toFixed(0)},${(120 - h - 30).toFixed(0)} L${(cx + 5).toFixed(0)},${(120 - h - 30).toFixed(0)} L${(cx + 5).toFixed(0)},${(120 - h).toFixed(0)}`;
    skylineLights.push({ x: Math.round(cx + 2), y: Math.round(120 - h - 33), r: 2, red: true });
  }
  for (let i = 0; i < 3; i++) skylineLights.push({ x: Math.round(x + rnd() * w), y: Math.round(120 - rnd() * h), r: 1.2, red: false });
  x += w;
}
skyline += ' L1600,120 Z';
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0a0f1f" />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {SITE.analytics.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.analytics.gaId }}>
          // 手元（localhost）で見ているときは数えない
          if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', gaId);
          }
        </script>
      </>
    )}
    {SITE.analytics.goatcounter && (
      <script is:inline async data-goatcounter={`https://${SITE.analytics.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <slot name="before" />
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url('')}>
          <svg class="brand__icon" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="26" height="26" rx="4" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M16 3v26M3 16h26" stroke="currentColor" stroke-width="2.5"/><circle cx="22" cy="10" r="2.6" fill="var(--warm)"/></svg>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="メインメニュー">
          <ul class="nav">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <svg class="skyline" viewBox="0 0 1600 120" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path class="skyline__land" d={skyline} />
        {skylineLights.map((l) => <circle cx={l.x} cy={l.y} r={l.r} class={l.red ? 'skyline__red' : 'skyline__light'} />)}
      </svg>
      <div class="wrap site-footer__inner">
        <p class="site-footer__name">{SITE.name}</p>
        <ul class="site-footer__links">
          <li><a href={url('posts/')}>記事一覧</a></li>
          <li><a href={url('profile/')}>プロフィール</a></li>
          <li><a href={url('contact/')}>お問い合わせ</a></li>
          <li><a href={url('privacy/')}>プライバシーポリシー</a></li>
          <li><a href={url('?opening=1')}>オープニングをもう一度見る</a></li>
        </ul>
        {SITE.analytics.goatcounter && (
          <p class="site-footer__count" id="visitor-count" data-code={SITE.analytics.goatcounter} hidden>
            これまでに <strong>-</strong> 人が窓際をのぞきました
          </p>
        )}
        <p class="site-footer__copy">© {new Date().getFullYear()} {SITE.author}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // フッターの訪問者数（GoatCounter の公開カウンター）。取れなければ何も出さない
  const el = document.getElementById('visitor-count');
  if (el) {
    fetch(`https://${el.dataset.code}.goatcounter.com/counter/TOTAL.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d: { count?: string }) => {
        if (!d.count) return;
        el.querySelector('strong')!.textContent = d.count;
        el.hidden = false;
      })
      .catch(() => {});
  }
</script>

<style>
  .site-footer__count { margin: 1rem 0 0; color: var(--muted); }
  .site-footer__count strong {
    font-family: var(--font-head);
    font-size: 1.3em;
    color: var(--accent);
    text-shadow: 0 0 12px rgb(255 179 92 / 0.5);
    margin-inline: 0.15em;
  }
  .site-header {
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(10 15 31 / 0.72);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
    min-height: 3.5rem;
    padding-block: 0.4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }
  .brand__icon { width: 1.5rem; height: 1.5rem; color: var(--cool); flex: none; filter: drop-shadow(0 0 6px rgb(159 212 255 / 0.5)); }
  .nav {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: inline-block;
    padding: 0.5rem 0.65rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    border-radius: 6px;
  }
  .nav a:hover { color: var(--ink); background: var(--surface); }
  .nav a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }

  @media (max-width: 30rem) {
    .site-header__inner { justify-content: center; }
    .nav a { padding: 0.35rem 0.55rem; font-size: 0.85rem; }
  }

  main { display: block; min-height: 60vh; }

  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    background: #060914;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .site-footer__inner { padding-block: 1.5rem 2.5rem; }
  .skyline {
    display: block;
    width: 100%;
    height: 90px;
    margin-top: -89px;
    background: linear-gradient(to bottom, transparent, rgb(255 150 60 / 0.12));
  }
  .skyline__land { fill: #060914; }
  .skyline__light { fill: #ffcf86; opacity: 0.8; }
  .skyline__red { fill: #ff5b4a; }
  .site-footer__name {
    margin: 0 0 0.75rem;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--ink);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__links a { color: var(--muted); }
  .site-footer__copy { margin: 1rem 0 0; font-size: 0.8rem; }
</style>
