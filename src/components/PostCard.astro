---
import { Image } from 'astro:assets';
import { url, formatDate, isoDate, categorySlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
  /** 大きく見せる（トップの一番新しい記事など） */
  feature?: boolean;
}
const { post, eager = false, feature = false } = Astro.props;
const { title, date, category, image, description } = post.data;
---
<article class:list={["card", { "card--feature": feature }]}>
  <a class="card__media" href={url(`posts/${post.id}/`)} tabindex="-1" aria-hidden="true">
    {image ? (
      <Image src={image} alt="" widths={feature ? [600, 1000, 1400] : [400, 800]} sizes={feature ? "(max-width: 48rem) 100vw, 44rem" : "(max-width: 40rem) 100vw, 24rem"} loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <span class="card__noimg">{category}</span>
    )}
  </a>
  <div class="card__body">
    <p class="card__meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <a class="chip" href={url(`category/${categorySlug(category)}/`)}>{category}</a>
    </p>
    <h3 class="card__title"><a href={url(`posts/${post.id}/`)}>{title}</a></h3>
    {description && <p class="card__desc">{description}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: var(--glow); border-color: rgb(255 92 138 / 0.6); }
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--line);
    overflow: hidden;
  }
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, rgb(8 7 10 / 0.55));
    pointer-events: none;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .card:hover .card__media :global(img) { transform: scale(1.05); }
  .card__noimg {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-head);
    font-size: 1.5rem;
    color: var(--muted);
  }
  .card__body { padding: 1rem 1.15rem 1.25rem; }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .card__meta .chip { border-color: rgb(255 92 138 / 0.45); color: var(--accent); background: rgb(255 92 138 / 0.08); }
  .card__title {
    margin: 0.55rem 0 0;
    font-size: 1.15rem;
  }
  .card__title a { color: var(--ink); text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; } /* カード全体をリンクに */
  .card__title a:hover { color: var(--accent); }
  .card__desc {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .card__meta .chip { position: relative; z-index: 1; }

  /* 大きいカード */
  .card--feature .card__title { font-size: clamp(1.35rem, 3.5vw, 1.9rem); }
  .card--feature .card__desc { font-size: 1rem; }
  @media (min-width: 48rem) {
    .card--feature { display: grid; grid-template-columns: 1.4fr 1fr; }
    .card--feature .card__media { aspect-ratio: auto; min-height: 22rem; }
    .card--feature .card__body { display: grid; align-content: center; padding: 2rem; }
  }
</style>
