---
// オープニング演出の見た目。動きは opening.ts、ネオン街と部屋の絵は scenes.ts。
import { streetSvg, roomSvg } from './scenes';
---
<!-- 落書き用の2書体（オープニングだけで使う） -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik+Spray+Paint&family=Sedgwick+Ave+Display&display=swap" />
<div class="op" id="opening" role="region" aria-label="オープニング演出">
  <div class="op__stage">
    <div class="op__scene op__street">
      <svg width="1600" height="900" viewBox="0 0 1600 900" aria-hidden="true" set:html={streetSvg}></svg>
    </div>
    <div class="op__scene op__room">
      <svg width="1600" height="900" viewBox="0 0 1600 900" aria-hidden="true" set:html={roomSvg}></svg>
      <canvas class="op__tv-static" width="73" height="72" aria-hidden="true"></canvas>
      <div class="op__tv-glass" aria-hidden="true"></div>
    </div>
  </div>
  <canvas class="op__fx op__rain" aria-hidden="true"></canvas>
  <canvas class="op__fx op__static" aria-hidden="true"></canvas>
  <div class="op__fx op__scan" aria-hidden="true"></div>
  <div class="op__fx op__black" aria-hidden="true"></div>

  <button class="op__btn op__skip" type="button">SKIP <span aria-hidden="true">›</span></button>
  <button class="op__btn op__sound" type="button" aria-pressed="false">SOUND ON</button>
</div>

<style>
  .op {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #000;
    color: #fff;
    overflow: hidden;
    transition: opacity 0.45s ease;
  }
  :global(html.op-play) .op { display: block; }
  :global(html.op-play body) { overflow: hidden; }
  .op.is-thin { background: transparent; }
  .op.is-leaving { opacity: 0 !important; pointer-events: none; }

  /* 絵は 1600×900 の舞台に描き、カメラの動きは舞台ごと拡大・移動する */
  .op__stage { position: absolute; left: 0; top: 0; width: 1600px; height: 900px; transform-origin: 0 0; }
  .op__scene { position: absolute; inset: 0; }
  .op__scene svg { position: absolute; left: 0; top: 0; overflow: visible; }

  /* ブラウン管の画面（絵の座標に合わせて置く） */
  .op__tv-static, .op__tv-glass { position: absolute; left: 1080px; top: 424px; width: 146px; height: 144px; border-radius: 18px; }
  .op__tv-static { image-rendering: pixelated; background: #222; }
  .op__tv-glass {
    background:
      radial-gradient(120% 90% at 30% 22%, rgb(255 255 255 / 0.22), transparent 42%),
      radial-gradient(closest-side, transparent 70%, rgb(0 0 0 / 0.55));
    box-shadow: inset 0 0 14px rgb(0 0 0 / 0.8);
  }

  .op__fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .op__static { image-rendering: pixelated; opacity: 0; }
  .op__scan { opacity: 0; background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.45) 0 2px, transparent 2px 4px); }
  .op__black { background: #000; }

  .op__btn {
    position: absolute;
    z-index: 2;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .op__btn:hover { background: rgb(0 0 0 / 0.6); }
  .op__btn:focus-visible { outline: 3px solid var(--cool); outline-offset: 3px; }
  .op__skip { top: max(1rem, env(safe-area-inset-top)); right: max(1rem, env(safe-area-inset-right)); }
  .op__sound { bottom: max(1rem, env(safe-area-inset-bottom)); left: max(1rem, env(safe-area-inset-left)); font-size: 0.8rem; }
  .op__sound[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 12px rgb(255 92 138 / 0.5); }
</style>

<script>
  import { runOpening } from './opening';

  const root = document.getElementById('opening');
  if (root && document.documentElement.classList.contains('op-play')) {
    runOpening(root);
  } else {
    root?.remove();
  }
</script>
