---
// 白鳥大橋の夜景（横から見た吊り橋と、対岸の工場夜景）。オープニングとトップページで使う。
// 座標は 1600×900 の画面上で計算している（写真や地図データは使わない）。
interface Props {
  /** 同じページに2枚置いても SVG の id がぶつからないようにするための接頭辞 */
  id: string;
  /** 星のまたたきなど、ゆっくりした動きを付けるか */
  live?: boolean;
  /** 画面への収め方（SVG の preserveAspectRatio） */
  fit?: string;
}
const { id, live = false, fit = 'xMidYMid meet' } = Astro.props;

// ---- 白鳥大橋（横から見た吊り橋）。座標は 1600×900 の画面上 ----
const WATER = 600;
const T1 = 560; // 主塔
const T2 = 1040;
const TOP = 335;
const A1 = 330; // アンカー
const A2 = 1270;
const SAG = 745; // 主ケーブルの制御点（最下点 ≒ 540）

const deckY = (x: number) => {
  if (x < T1 || x > T2) return 556;
  return 556 - 5 * Math.sin((Math.PI * (x - T1)) / (T2 - T1));
};
const mainCable = (s: number) => ({
  x: T1 + (T2 - T1) * s,
  y: (1 - s) ** 2 * TOP + 2 * s * (1 - s) * SAG + s ** 2 * TOP,
});
const quad = (p0: number[], c: number[], p1: number[], s: number) => ({
  x: (1 - s) ** 2 * p0[0] + 2 * s * (1 - s) * c[0] + s ** 2 * p1[0],
  y: (1 - s) ** 2 * p0[1] + 2 * s * (1 - s) * c[1] + s ** 2 * p1[1],
});
const sideL = { p0: [A1, 552], c: [480, 528], p1: [T1, TOP] };
const sideR = { p0: [T2, TOP], c: [1120, 528], p1: [A2, 552] };

const hangers: string[] = [];
for (let i = 1; i < 24; i++) {
  const p = mainCable(i / 24);
  hangers.push(`M${p.x.toFixed(1)},${p.y.toFixed(1)}V${deckY(p.x).toFixed(1)}`);
}
for (const side of [sideL, sideR]) {
  for (let i = 1; i < 10; i++) {
    const p = quad(side.p0, side.c, side.p1, i / 10);
    if (p.y < 548) hangers.push(`M${p.x.toFixed(1)},${p.y.toFixed(1)}V552`);
  }
}

// ケーブルの明かり
const cableLights: { x: number; y: number }[] = [];
for (let i = 0; i <= 40; i++) cableLights.push(mainCable(i / 40));
for (const side of [sideL, sideR]) {
  for (let i = 1; i < 14; i++) cableLights.push(quad(side.p0, side.c, side.p1, i / 14));
}
// 道路の街灯
const deckLights: number[] = [];
for (let x = 20; x < 1600; x += 46) deckLights.push(x);

// 決まった並びの乱数（ビルドごとに変わらないように）
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const skyStars = Array.from({ length: 70 }, () => ({
  x: rnd() * 1600,
  y: rnd() * 300,
  r: 0.6 + rnd() * 1.3,
  o: 0.3 + rnd() * 0.6,
}));

// 対岸の工場群（工場夜景）
const factories: { x: number; w: number; h: number }[] = [];
for (let x = -20; x < 1620; ) {
  const w = 18 + rnd() * 50;
  const zone = x < 300 || x > 1150;
  factories.push({ x, w, h: zone ? 8 + rnd() * 28 : 3 + rnd() * 8 });
  x += w + rnd() * 10;
}
const chimneys = [80, 190, 1220, 1330, 1460, 1540].map((x) => ({ x, h: 40 + rnd() * 30 }));
const factoryLights = Array.from({ length: 140 }, () => {
  const x = rnd() * 1600;
  const zone = x < 320 || x > 1130;
  return { x, y: WATER - 3 - rnd() * (zone ? 30 : 8), r: 0.8 + rnd() * 1.4, warm: rnd() > 0.35 };
});

const hills =
  'M0,560 C90,548 150,520 240,526 C320,532 380,560 460,566 C560,574 640,566 720,570 C820,575 900,574 980,568 C1080,560 1150,528 1240,520 C1330,512 1400,540 1480,548 C1530,553 1570,556 1600,556 L1600,600 L0,600Z';

const fmt = (n: number) => n.toFixed(1);
---
<svg viewBox="0 0 1600 900" preserveAspectRatio={fit} width="100%" height="100%" class:list={["nb", { "nb--live": live }]} aria-hidden="true">
  <defs>
    <radialGradient id={`${id}-glow`}>
      <stop offset="0" stop-color="#fff4cf" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fff4cf" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-refl`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.5" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id={`${id}-refl-mask`}><rect x="0" y={WATER} width="1600" height="300" fill={`url(#${id}-refl)`} /></mask>
  </defs>

  <g class="sky-stars">
    {skyStars.map((s) => <circle cx={fmt(s.x)} cy={fmt(s.y)} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} />)}
  </g>

  <path class="hills" d={hills} />
  <g class="factories">
    {factories.map((f) => <rect x={fmt(f.x)} y={fmt(WATER - f.h)} width={fmt(f.w)} height={fmt(f.h)} />)}
    {chimneys.map((c) => <rect x={c.x} y={fmt(WATER - c.h)} width="5" height={fmt(c.h)} />)}
  </g>
  <g class="factory-lights">
    {factoryLights.map((l) => <circle cx={fmt(l.x)} cy={fmt(l.y)} r={l.r.toFixed(2)} class={l.warm ? 'warm' : 'cool'} />)}
    {chimneys.map((c) => <circle cx={c.x + 2.5} cy={fmt(WATER - c.h - 2)} r="2" class="red" />)}
  </g>

  <g id={`${id}-shape`}>
    <g class="bridge">
      <!-- 道路 -->
      <path class="deck" d={`M0,556 L${T1},556 Q${(T1 + T2) / 2},546 ${T2},556 L1600,556 L1600,566 L${T2},566 Q${(T1 + T2) / 2},556 ${T1},566 L0,566Z`} />
      <!-- 橋脚 -->
      {[80, 200, A1, A2, 1400, 1520].map((x) => <rect class="pier" x={x - 6} y="566" width="12" height={WATER - 566} />)}
      <!-- ハンガー -->
      <path class="hanger" d={hangers.join('')} />
      <!-- ケーブル -->
      <path class="cable" d={`M${A1},552 Q${sideL.c.join(',')} ${T1},${TOP} Q${(T1 + T2) / 2},${SAG} ${T2},${TOP} Q${sideR.c.join(',')} ${A2},552`} />
      <!-- 主塔 -->
      {[T1, T2].map((x) => (
        <g class="tower">
          <rect x={x - 9} y={TOP - 8} width="7" height={WATER - TOP + 8} />
          <rect x={x + 2} y={TOP - 8} width="7" height={WATER - TOP + 8} />
          <rect x={x - 9} y={TOP - 8} width="18" height="9" />
          <rect x={x - 9} y={TOP + 95} width="18" height="6" />
          <rect x={x - 9} y={TOP + 185} width="18" height="6" />
        </g>
      ))}
    </g>
    <g class="lights">
      {cableLights.map((p) => <circle class="halo" fill={`url(#${id}-glow)`} cx={fmt(p.x)} cy={fmt(p.y)} r="9" />)}
      {cableLights.map((p) => <circle class="bulb" cx={fmt(p.x)} cy={fmt(p.y)} r="2.2" />)}
      {deckLights.map((x) => <circle class="street" cx={x} cy={fmt(deckY(x) - 4)} r="1.8" />)}
      {[T1, T2].map((x) => <circle class="red" cx={x} cy={TOP - 12} r="3" />)}
    </g>
  </g>

  <!-- 海に映る橋 -->
  <g mask={`url(#${id}-refl-mask)`}>
    <use href={`#${id}-shape`} transform={`translate(0 ${WATER * 2}) scale(1 -1)`} />
  </g>
  <g class="ripples">
    {Array.from({ length: 18 }, (_, i) => {
      const y = WATER + 8 + i * i * 0.9;
      const x = (i * 337) % 1400;
      return <rect x={x} y={fmt(y)} width={120 + ((i * 53) % 260)} height="1.5" />;
    })}
  </g>
</svg>

<style>
  .nb { display: block; }
  .sky-stars circle { fill: #fff; }
  .hills { fill: #0c1226; }
  .factories rect { fill: #0a0f1e; }
  .factory-lights .warm { fill: #ffcf86; }
  .factory-lights .cool { fill: #cfe8ff; opacity: 0.8; }
  .red { fill: #ff5b4a; }
  .deck { fill: #d7dce6; }
  .pier { fill: #b9bfcc; }
  .tower rect { fill: #eef1f6; }
  .cable { fill: none; stroke: #eef1f6; stroke-width: 3; }
  .hanger { fill: none; stroke: #eef1f6; stroke-opacity: 0.55; stroke-width: 0.9; }
  .halo { opacity: 0.55; }
  .bulb { fill: #fffbe8; }
  .street { fill: #ffc56b; }
  .ripples rect { fill: #9fb6e0; opacity: 0.12; }

  /* ゆっくりした動き（トップページ用）。動きを減らす設定では止める */
  @media (prefers-reduced-motion: no-preference) {
    .nb--live .sky-stars circle:nth-child(3n) { animation: nb-twinkle 3.2s ease-in-out infinite; }
    .nb--live .sky-stars circle:nth-child(3n + 1) { animation: nb-twinkle 4.6s ease-in-out 1.2s infinite; }
    .nb--live .halo { animation: nb-glow 5s ease-in-out infinite; }
    .nb--live .factory-lights .red { animation: nb-blink 2.4s steps(1) infinite; }
    .nb--live .lights .red { animation: nb-blink 2s steps(1) 0.6s infinite; }
  }
  @keyframes nb-twinkle { 50% { opacity: 0.15; } }
  @keyframes nb-glow { 50% { opacity: 0.9; } }
  @keyframes nb-blink { 50% { opacity: 0.15; } }
</style>
